# Font
# Without font-family Ghostty uses its built-in JetBrains Mono with Nerd Font symbols.
# font-family = CommitMono Nerd Font Mono
font-size = 11

# Theme
theme = TokyoNight Night
background-opacity = 0.96

# Window (size is in terminal cells, not pixels)
window-decoration = none
window-width = 160
window-height = 45
window-save-state = never

# Keys
keybind = ctrl+shift+slash=toggle_fullscreen
# Left Option acts as Alt for tmux/nvim bindings, right Option still types symbols
macos-option-as-alt = left
