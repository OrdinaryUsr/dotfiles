# Font
# Install with: brew install --cask font-commit-mono-nerd-font
# If the font is missing, Ghostty falls back to its built-in JetBrains Mono.
font-family = CommitMono Nerd Font Mono
font-size = 11

# Theme
theme = Dracula
background-opacity = 0.96

# Window (size is in terminal cells, not pixels)
# Hide the titlebar but keep native decorations: native fullscreen
# (separate Space) does not work with window-decoration = none.
macos-titlebar-style = hidden
window-width = 160
window-height = 45
window-save-state = never
# Space between the text and the window edges, in points
window-padding-x = 4
window-padding-y = 4

# Mouse
mouse-hide-while-typing = true

# Keys
keybind = ctrl+shift+slash=toggle_fullscreen
# Quick terminal: drops down over any app. `global:` needs the Accessibility
# permission and takes the key away from every other app, so plain cmd+enter
# (send/submit in most apps) is avoided on purpose.
keybind = global:cmd+shift+enter=toggle_quick_terminal
# Left Option acts as Alt for tmux/nvim bindings, right Option still types symbols
macos-option-as-alt = left
